# ==============================================================================
# AI-Telegram Bot Configuration (.env.example)
# Copy this file to .env and fill in your local credentials.
# ==============================================================================

# --- Storage Portability ---
# Local path for persistent Docker volumes (Postgres, Redis, Ollama, Datasets).
# Windows example: E:/AI-Telegram/data
# macOS/Linux default: ./data
DATA_DIR=./data

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of admin Telegram user IDs allowed to switch models or view stats
ADMIN_USER_IDS=123456789
# Max attachment file size in MB allowed for processing (default: 50)
MAX_TELEGRAM_FILE_MB=50

# --- AI Model Progression (3-Stage Pipeline) ---
# Allowed values: gemini | ollama | huggingface
AI_BACKEND=gemini

# Stage 1: Gemini Teacher
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Stage 2: Open Source via Ollama (Local Bridge)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hybrid RAG & Reranker Settings
RAG_CANDIDATE_K=15
RAG_TOP_K=3
RAG_RERANKER_THRESHOLD=0.35
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Stage 3: Hugging Face Fine-tuned Student / vLLM OpenAI-compatible Server
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_SERVING_URL=http://vllm:8000/v1
HF_API_KEY=EMPTY

# --- PostgreSQL + pgvector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_change_me
POSTGRES_DB=ai_telegram
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5436
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secret_change_me@postgres:5432/ai_telegram

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_CHAT_HISTORY_TTL=86400
REDIS_CHAT_WINDOW_SIZE=10
REDIS_CACHE_TTL=3600

# --- Spaced Repetition & Jobs ---
VOCAB_QUIZ_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# --- Web Admin Dashboard (FastAPI + SQLAdmin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_secret_pass_123
ADMIN_SECRET_KEY=admin_session_secret_key_change_me_in_production_32bytes
ADMIN_PORT=8000

